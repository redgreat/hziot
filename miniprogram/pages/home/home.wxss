.wrap { display: flex; flex-direction: column; height: 100vh; }
.proj-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 24rpx; background: #fff;
}
.proj-pick { font-size: 30rpx; font-weight: 600; }
.map { width: 100%; height: 46vh; }
.devs { flex: 1; }
.dev-head { display: flex; justify-content: space-between; align-items: center; }
.dev-name { font-size: 30rpx; font-weight: 600; }
.dev-row { font-size: 24rpx; color: #4a564d; margin-top: 6rpx; word-break: break-all; }

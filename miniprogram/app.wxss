/* app.wxss — 全局样式 */
page {
  background: #f5f7f4;
  font-size: 28rpx;
  color: #22301f;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.btn {
  background: #2f7d46;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.btn[disabled] {
  background: #a5c2ae;
  color: #eef4ef;
}
.btn-ghost {
  background: #fff;
  color: #2f7d46;
  border: 2rpx solid #2f7d46;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.muted { color: #7d8a80; font-size: 24rpx; }
.warn { color: #c0392b; font-size: 24rpx; }
.badge {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}
.badge-on { background: #e3f3e7; color: #2f7d46; }
.badge-off { background: #edeff0; color: #7d8a80; }
